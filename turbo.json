{
  "$schema": "https://turbo.build/schema.json",
  "globalPassThroughEnv": ["NODE_OPTIONS"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**"],
      "env": [
        "NODE_ENV",
        "OSS_GIT_COMMIT_SHA",
        "NEXT_PUBLIC_*",
        "GOOGLE_CLIENT_ID",
        "GOOGLE_API_KEY",
        "GOOGLE_PROJECT_NUMBER"
      ]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {
      "dependsOn": ["^build"]
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "test": {
      "dependsOn": ["^build"],
      "env": ["BRIAN_TEST_PARTITION"],
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/scripts/testing/unit-partition.mjs", "$TURBO_ROOT$/scripts/testing/run-fast-checks.mjs", "$TURBO_ROOT$/packages/shared/src/department-isolation-coverage.ts"]
    },
    "test:integration": {
      "cache": false,
      "dependsOn": ["^build"]
    }
  }
}
