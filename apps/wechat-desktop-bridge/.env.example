# Use Brian side (Studio -> Channels -> + Add channel -> Custom, kind "wechat-desktop")
BRIAN_API_URL=https://api.usebrian.ai
BRIAN_CHANNEL_ID=
BRIAN_BRIDGE_TOKEN=

# agent-wechat container (same token you wrote to ./agent-wechat-token)
AGENT_WECHAT_URL=http://agent-wechat:6174
AGENT_WECHAT_TOKEN=
# Path to the standalone source checkout used by docker compose.
# Default from this directory: ../../../brian-message-store/agent-wechat
# AGENT_WECHAT_SOURCE=/opt/brian-message-store/agent-wechat
# AGENT_WECHAT_IMAGE=use-brian/agent-wechat:local

# Optional
BRIDGE_STATE_FILE=/data/bridge-state.json
POLL_INTERVAL_MS=3000
BACKFILL_ON_FIRST_BOOT=false
BRIDGE_PORT=8086
