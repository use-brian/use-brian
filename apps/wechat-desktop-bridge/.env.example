# Use Brian side (Studio -> Channels -> + Add channel -> Custom, kind "wechat-desktop")
BRIAN_API_URL=https://api.usebrian.ai
BRIAN_CHANNEL_ID=
BRIAN_BRIDGE_TOKEN=

# agent-wechat container (same token you wrote to ./agent-wechat-token)
AGENT_WECHAT_URL=http://agent-wechat:6174
AGENT_WECHAT_TOKEN=

# Optional
BRIDGE_STATE_FILE=/data/bridge-state.json
POLL_INTERVAL_MS=3000
BACKFILL_ON_FIRST_BOOT=false
BRIDGE_PORT=8086
