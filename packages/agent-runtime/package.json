{
  "name": "@use-brian/agent-runtime",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "license": "AGPL-3.0-only",
  "description": "Provider-neutral agent runtime (query loop, providers, tool contract, context primitives, compaction, cost tracking, MCP protocol types). See README.md.",
  "exports": {
    "./package.json": "./package.json",
    "./*.js": {
      "types": "./dist/*.d.ts",
      "default": "./dist/*.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.98.0",
    "@openai/codex": "0.171.0",
    "@openai/codex-catalog": "npm:@openai/codex@0.171.0",
    "@use-brian/shared": "workspace:*",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "sharp": "^0.34.3",
    "undici": "7.28.0",
    "zod": "^3.24"
  },
  "devDependencies": {
    "@types/node": "^20.19.39",
    "dotenv": "^16",
    "typescript": "^5.7",
    "vitest": "^3"
  }
}
