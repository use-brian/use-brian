{
  "name": "@use-brian/core",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "exports": {
    "./package.json": "./package.json",
    "./*.js": {
      "types": "./dist/*.d.ts",
      "default": "./dist/*.js"
    }
  },
  "//": {
    "exports": "Import file-level subpaths only: @use-brian/core/<path>.js (runtime names from @use-brian/agent-runtime/<path>.js). There is no root entry: the aggregate barrel, its transitional named-export successor, the \".\" export, main/types and ./dist/* were deleted in the M4 final cut (D13), docs/plans/oss-chat-m4-runtime-separation-plan.md step 7."
  },
  "scripts": {
    "build": "tsc && rm -rf dist/skills/builtin && (test -d src/skills/builtin && cp -r src/skills/builtin dist/skills/builtin || true)",
    "typecheck": "tsc --noEmit && tsc --noEmit -p scripts/tsconfig.json",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "smoke": "tsx scripts/smoke.ts"
  },
  "dependencies": {
    "@cantoo/fontkit": "2.0.12",
    "@cantoo/pdf-lib": "2.11.1",
    "@firecrawl/anydoc": "0.1.3",
    "@fontsource/noto-sans": "5.3.0",
    "@fontsource/noto-sans-jp": "5.3.0",
    "@fontsource/noto-sans-sc": "5.3.0",
    "@mozilla/readability": "^0.5.0",
    "@napi-rs/canvas": "^0.1.100",
    "@use-brian/agent-runtime": "workspace:*",
    "@use-brian/brian-kb": "workspace:*",
    "@use-brian/office-model": "workspace:*",
    "@use-brian/office-renderer": "workspace:*",
    "@use-brian/shared": "workspace:*",
    "crc-32": "^1.2.2",
    "decimal.js": "^10.6.0",
    "docx": "^9.7.1",
    "e2b": "^2.32.0",
    "exceljs": "^4.4.0",
    "jszip": "^3.10.1",
    "linkedom": "^0.18.0",
    "turndown": "^7.2.4",
    "turndown-plugin-gfm": "^1.0.2",
    "opencc-js": "^1.4.1",
    "pdfjs-dist": "~5.6.205",
    "pptxgenjs": "^4.0.1",
    "sharp": "^0.34.3",
    "tldts": "7.4.3",
    "unpdf": "^1.6.2",
    "yjs": "13.6.31",
    "zod": "^3.24"
  },
  "devDependencies": {
    "@types/node": "^20.19.39",
    "@types/turndown": "^5.0.6",
    "typescript": "^5.7",
    "vitest": "^3"
  }
}
