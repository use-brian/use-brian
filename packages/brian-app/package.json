{
  "name": "@use-brian/brian-app",
  "version": "0.1.0",
  "description": "Manifest and bundle validation, browser application client, and deployed module/source SDK profiles for Use Brian.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./connector": {
      "types": "./dist/connector.d.ts",
      "import": "./dist/connector.js"
    },
    "./application": {
      "types": "./dist/application.d.ts",
      "import": "./dist/application.js"
    },
    "./module": {
      "types": "./dist/module.d.ts",
      "import": "./dist/module.js"
    }
  },
  "bin": {
    "brian-app": "./bin/brian-app.js"
  },
  "files": [
    "bin",
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/use-brian/use-brian",
    "directory": "packages/brian-app"
  },
  "devDependencies": {
    "@types/node": "^20.19.39",
    "typescript": "^5.7",
    "vitest": "^3",
    "@use-brian/shared": "workspace:*",
    "@use-brian/core": "workspace:*"
  },
  "peerDependencies": {
    "@use-brian/shared": "0.0.1",
    "@use-brian/core": "0.0.1"
  },
  "peerDependenciesMeta": {
    "@use-brian/core": {
      "optional": true
    }
  }
}
