{
  "name": "Use Brian",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "description": "A local brain for your work, that dreams.",
  "license": "AGPL-3.0-only",
  "scripts": {
    "build": "turbo run build",
    "start": "node scripts/launch.mjs",
    "support": "node scripts/support.mjs",
    "native:readiness": "node scripts/native-computer-readiness.mjs",
    "dev": "node scripts/launch.mjs",
    "dev:watch": "turbo run dev",
    "rig:up": "scripts/rig-up.sh",
    "rig:down": "scripts/rig-down.sh",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:scripts": "node --test scripts/__tests__/*.test.mjs",
    "test:integration": "turbo run test:integration",
    "smoke": "pnpm --filter @use-brian/core smoke",
    "release:browser-extension": "scripts/publish-browser-extension.sh",
    "eval": "pnpm --filter @use-brian/api eval"
  },
  "devDependencies": {
    "@types/pg": "^8.11.10",
    "pg": "^8.13.1",
    "tsx": "^4.19.2",
    "turbo": "^2.3.3",
    "typescript": "^5.7"
  }
}
